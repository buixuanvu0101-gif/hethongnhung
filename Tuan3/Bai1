#include "stm32f1xx.h"


#define MA_LOP  "01"
#define MA_NHOM "10"

#define MAX_BUFFER_SIZE 100


char rx_buffer[MAX_BUFFER_SIZE];
uint8_t rx_index = 0;


void UART1_Init(void) {
  
    RCC->APB2ENR |= (1 << 2) | (1 << 14); 

    
    GPIOA->CRH &= 0xFFFFF00F; 
    GPIOA->CRH |= 0x000004B0; // PA9 là TX (Alternate Push-Pull), PA10 là RX (Input Floating)

    // 3. Thiết lập Baudrate = 9600 (với xung nhịp mặc định HSI 8MHz)
    USART1->BRR = 0x341;

    // 4. Bật USART1, kích hoạt cả Transmitter (phát) và Receiver (nhận)
    USART1->CR1 |= (1 << 13) | (1 << 3) | (1 << 2); 
}

// Hàm gửi 1 ký tự qua UART
void UART1_SendChar(char c) {
    while(!(USART1->SR & (1 << 7))); // Chờ cờ TXE (bộ đệm phát trống)
    USART1->DR = c;
}

// Hàm gửi 1 chuỗi ký tự qua UART
void UART1_SendString(char *str) {
    while(*str) {
        UART1_SendChar(*str++);
    }
}

// ================= HÀM MAIN =================
int main(void) {
    UART1_Init();
    
    // Xóa màn hình terminal lúc mới khởi động
    UART1_SendString("\033[2J\033[H"); 

    while(1) {
        // Kiểm tra cờ RXNE (Bit 5 trong thanh ghi SR) - Có dữ liệu gửi đến
        if (USART1->SR & (1 << 5)) {
            // Đọc ký tự từ thanh ghi dữ liệu
            char received_char = USART1->DR; 
            
            // Lưu ký tự vào bộ đệm nếu chưa đầy
            if (rx_index < MAX_BUFFER_SIZE - 1) {
                rx_buffer[rx_index] = received_char;
                rx_index++;
            }
            
            // Nếu nhận được ký tự kết thúc là dấu '!'
            if (received_char == '!') {
                // Đóng chuỗi bộ đệm lại
                rx_buffer[rx_index] = '\0';
                
                // Gửi lại PC theo định dạng: <Mã lớp><Mã nhóm>: <Bản tin>\n\r
                UART1_SendString(MA_LOP);
                UART1_SendString(MA_NHOM);
                UART1_SendString(": ");
                UART1_SendString(rx_buffer);
                
                // Gửi ký tự kết thúc \n\r theo đúng yêu cầu đề bài
                UART1_SendChar('\n');
                UART1_SendChar('\r');
                
                // Xóa bộ đệm để sẵn sàng nhận bản tin tiếp theo
                rx_index = 0;
            }
        }
    }
}
