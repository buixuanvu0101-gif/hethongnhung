#include "stm32f1xx.h"

void PWM_Configuration(void) {
   
    RCC->APB2ENR |= (1 << 2); 
    RCC->APB1ENR |= (1 << 0); 

  
    GPIOA->CRL &= ~0x0000FFFF; 
    GPIOA->CRL |=  0x0000BBBB;

   
    TIM2->PSC = 8 - 1;  
    TIM2->ARR = 1000 - 1; 

    
    TIM2->CCMR1 |= (0x6 << 4)  | (1 << 3);  // Kênh 1 (PA0)
    TIM2->CCMR1 |= (0x6 << 12) | (1 << 11); // Kênh 2 (PA1)
    TIM2->CCMR2 |= (0x6 << 4)  | (1 << 3);  // Kênh 3 (PA2)
    TIM2->CCMR2 |= (0x6 << 12) | (1 << 11); // Kênh 4 (PA3)

    
    TIM2->CCER |= (1 << 0) | (1 << 4) | (1 << 8) | (1 << 12);

   
    TIM2->CCR1 = 100; // LED 1: 10% của 1000
    TIM2->CCR2 = 300; // LED 2: 30% của 1000
    TIM2->CCR3 = 500; // LED 3: 50% của 1000
    TIM2->CCR4 = 700; // LED 4: 70% của 1000

    
    TIM2->CR1 |= (1 << 0);
}

int main(void) {
   
    PWM_Configuration();
    
   
    while (1) {
    }
}
