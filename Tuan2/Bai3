#include "stm32f1xx.h"

void delay_1s(void) {
    
    for(volatile uint32_t i = 0; i < 1600000; i++) {
        __NOP();
    }
}


void UART1_Init(void) {
   
    RCC->APB2ENR |= (1 << 2) | (1 << 14); 

   
    GPIOA->CRH &= 0xFFFFF00F; 
    GPIOA->CRH |= 0x000004B0; 

   
    USART1->BRR = 0x341;

   
    USART1->CR1 |= (1 << 13) | (1 << 3) | (1 << 2); 
}


void UART1_SendChar(char c) {
   
    while(!(USART1->SR & (1 << 7))); 
    USART1->DR = c;
}


void UART1_SendString(char *str) {
    while(*str) {
        UART1_SendChar(*str++);
    }
}


void ADC1_Init(void) {
   
    RCC->APB2ENR |= (1 << 9) | (1 << 2); 

 
    RCC->CFGR |= (2 << 14);

    
    GPIOA->CRL &= 0xFFFFFFF0; 

   
    ADC1->CR2 |= (1 << 0);
    
    for(volatile int i = 0; i < 1000; i++); 
    
   
    ADC1->CR2 |= (1 << 3); 
    while(ADC1->CR2 & (1 << 3));
    
    ADC1->CR2 |= (1 << 2); 
    while(ADC1->CR2 & (1 << 2)); 

    
    ADC1->SQR3 &= ~(0x1F); 
}


uint16_t ADC1_Read(void) {
    
    ADC1->CR2 |= (1 << 0); 
    
   
    while(!(ADC1->SR & (1 << 1))); 
    
   
    return ADC1->DR;
}


int main(void) {
   
    UART1_Init();
    ADC1_Init();
 UART1_SendString("\033[2J\033[H"); 
    UART1_SendString("==== CHUONG TRINH DOC ADC ====\r\n");

    while(1) {
       
        uint16_t adc_value = ADC1_Read();

      
        uint32_t voltage_mv = ((uint32_t)adc_value * 3300) / 4095;
        uint32_t mV_int = voltage_mv / 1000;      // Phần nguyên (Volt)
        uint32_t mV_dec = voltage_mv % 1000;     // Phần thập phân (milivolt)

       
        UART1_SendString("ADC Raw: ");
        char num_buf[10];
        int i = 0;
        int temp = adc_value;
        
        if(temp == 0) {
            UART1_SendChar('0');
        } else {
            while(temp > 0) {
                num_buf[i++] = (temp % 10) + '0';
                temp /= 10;
            }
            while(i > 0) UART1_SendChar(num_buf[--i]);
        }

       
        UART1_SendString(" | Voltage: ");
        UART1_SendChar(mV_int + '0'); // Phần nguyên
        UART1_SendChar('.');          // Dấu thập phân
        UART1_SendChar((mV_dec / 100) + '0');      // Số thứ 1 sau phẩy
        UART1_SendChar(((mV_dec / 10) % 10) + '0'); // Số thứ 2 sau phẩy
        UART1_SendChar((mV_dec % 10) + '0');       // Số thứ 3 sau phẩy
        UART1_SendString(" V\r\n"); // Xuống dòng

      
        delay_1s();
    }
}
