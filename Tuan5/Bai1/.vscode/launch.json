{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug STM32F103 (ST-Link)",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "openocd",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/led_freertos.elf",
      "device": "STM32F103C8",
      "configFiles": ["interface/stlink.cfg", "target/stm32f1x.cfg"],
      "gdbPath": "gdb-multiarch",
      "preLaunchTask": "build",
      "runToEntryPoint": "main"
    }
  ]
}
