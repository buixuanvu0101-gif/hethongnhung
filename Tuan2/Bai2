#include "stm32f1xx.h"

void GPIO_Configuration(void) {
   
    RCC->APB2ENR |= (1 << 4) | (1 << 3); 

    
    GPIOC->CRH &= ~(0xF << 20); 
    GPIOC->CRH |=  (0x3 << 20); 

    
    GPIOB->CRL &= ~((0xF << 0) | (0xF << 4)); 
    GPIOB->CRL |=  ((0x3 << 0) | (0x3 << 4)); 
}

int main(void) {
    
    __enable_irq();

    GPIO_Configuration();
    
   
    if (SysTick_Config(8000000 / 1000)) {
        while (1); 
    }
    
    while (1) {
        
    }
}


void SysTick_Handler(void) {
    static uint16_t count_10hz = 0;
    static uint16_t count_1hz = 0;
    static uint16_t count_01hz = 0;

    
    if (++count_10hz >= 50) {
        count_10hz = 0;
        GPIOC->ODR ^= (1 << 13); 
    }
    
    
    if (++count_1hz >= 500) {
        count_1hz = 0;
        GPIOB->ODR ^= (1 << 0); 
    }
    
   
    if (++count_01hz >= 5000) {
        count_01hz = 0;
        GPIOB->ODR ^= (1 << 1); 
    }
}
